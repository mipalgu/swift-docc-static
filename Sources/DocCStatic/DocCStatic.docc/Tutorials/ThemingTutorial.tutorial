@Tutorial(time: 15) {
    @Intro(title: "Customising Your Documentation Theme") {
        Learn how to customise the appearance of your DocCStatic-generated documentation using built-in themes, custom theme directories, and CSS.

        @Image(source: "theme-hero.png", alt: "Documentation with custom theme")
    }

    @Section(title: "Using Built-in Themes") {
        @ContentAndMedia {
            DocCStatic includes two built-in themes: `default`, which matches swift-docc-render, and `docc-static-classic` (or `classic` for short), the original swift-docc-static appearance.

            @Image(source: "theme-comparison.png", alt: "Comparison of default and classic themes")
        }

        @Steps {
            @Step {
                Generate documentation with the default theme (no flags needed).

                @Code(name: "Terminal", file: "theme-default.sh")
            }

            @Step {
                Generate documentation with the classic theme using the `--theme` flag.

                @Code(name: "Terminal", file: "theme-classic.sh")
            }

            @Step {
                Using the SPM plugin, specify the theme with the same flag.

                @Code(name: "Terminal", file: "theme-plugin.sh")
            }
        }
    }

    @Section(title: "Creating a Custom Theme") {
        @ContentAndMedia {
            A custom theme is a directory with a `theme-settings.json` file in the swift-docc-render format, which works with both swift-docc and DocCStatic, and optional stylesheets.

            @Image(source: "theme-json.png", alt: "Theme settings JSON structure")
        }

        @Steps {
            @Step {
                Start by copying a built-in theme directory as a template.

                @Code(name: "Terminal", file: "theme-copy.sh")
            }

            @Step {
                Open the theme file and examine its structure. The theme contains colour and typography settings.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-structure.json")
            }

            @Step {
                Modify the accent colour. Change the `link` value to your desired colour.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-accent.json")
            }

            @Step {
                Add custom colours with separate light and dark mode values.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-light-dark.json")
            }

            @Step {
                Generate documentation with your custom theme by passing its directory to `--theme`, and optionally add a CSS file with `--custom-css`.

                @Code(name: "Terminal", file: "theme-custom-generate.sh")
            }
        }
    }

    @Section(title: "Customising Colours") {
        @ContentAndMedia {
            Theme colours control the overall appearance of your documentation, from backgrounds to syntax highlighting.

            @Image(source: "theme-colours.png", alt: "Colour customisation options")
        }

        @Steps {
            @Step {
                Set the primary background and text colours for better contrast.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-background.json")
            }

            @Step {
                Customise syntax highlighting colours to match your brand or improve readability.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-syntax.json")
            }

            @Step {
                Configure aside colours for notes, warnings, and other callouts.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-asides.json")
            }
        }
    }

    @Section(title: "Customising Typography") {
        @ContentAndMedia {
            Typography settings let you specify custom fonts for body text and code blocks.

            @Image(source: "theme-typography.png", alt: "Typography customisation")
        }

        @Steps {
            @Step {
                Set a custom body font using the `html-font` typography variable.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-font.json")
            }

            @Step {
                Set a custom monospace font for code blocks using `html-font-mono`.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-mono-font.json")
            }
        }
    }

    @Section(title: "Adding Custom CSS") {
        @ContentAndMedia {
            For advanced customisation, add stylesheets to your theme directory or append custom CSS to the generated stylesheet.

            @Image(source: "theme-css.png", alt: "Custom CSS styling")
        }

        @Steps {
            @Step {
                Add a `theme.css` file to your theme directory.  Stylesheets in a theme directory are applied after the base stylesheet, in file name order.

                @Code(name: "MyTheme/theme.css", file: "theme-stylesheet.css")
            }

            @Step {
                Create a ThemeConfiguration with custom CSS using the Swift API.

                @Code(name: "Theme.swift", file: "theme-custom-css.swift")
            }

            @Step {
                Override custom properties that your theme settings do not set.

                @Code(name: "Theme.swift", file: "theme-css-variables.swift")
            }

            @Step {
                Style specific elements like declaration blocks and topic items.

                @Code(name: "Theme.swift", file: "theme-element-styling.swift")
            }
        }
    }

    @Section(title: "Dark Mode Support") {
        @ContentAndMedia {
            DocCStatic supports automatic dark mode based on the user's system preference. Learn how to provide separate light and dark colour values.

            @Image(source: "theme-dark-mode.png", alt: "Light and dark mode comparison")
        }

        @Steps {
            @Step {
                Define colours with separate light and dark values in your theme file.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-dark-values.json")
            }

            @Step {
                For colours that should be the same in both modes, use a single string value.

                @Code(name: "MyTheme/theme-settings.json", file: "theme-single-value.json")
            }

            @Step {
                Disable dark mode if your theme doesn't support it.

                @Code(name: "Theme.swift", file: "theme-no-dark.swift")
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            What format do DocCStatic custom theme files use?

            @Choice(isCorrect: false) {
                CSS stylesheets

                @Justification(reaction: "Try again!") {
                    While you can add custom CSS, the main theme configuration uses a JSON format.
                }
            }

            @Choice(isCorrect: true) {
                JSON theme-settings format (compatible with swift-docc-render)

                @Justification(reaction: "Correct!") {
                    DocCStatic uses the same `theme-settings.json` format as swift-docc-render, allowing themes to be shared between the two tools.
                }
            }

            @Choice(isCorrect: false) {
                YAML configuration files

                @Justification(reaction: "That's not right.") {
                    DocCStatic doesn't use YAML for theming. Theme files use the JSON format.
                }
            }
        }

        @MultipleChoice {
            How do you specify different colours for light and dark mode?

            @Choice(isCorrect: false) {
                Create separate theme files for each mode

                @Justification(reaction: "Not quite!") {
                    You can specify both light and dark values in a single theme file.
                }
            }

            @Choice(isCorrect: true) {
                Use an object with "light" and "dark" keys instead of a single string value

                @Justification(reaction: "That's right!") {
                    Colour values can be either a single string (same for both modes) or an object with "light" and "dark" keys for mode-specific values.
                }
            }

            @Choice(isCorrect: false) {
                Use the @media (prefers-color-scheme) query in custom CSS

                @Justification(reaction: "Close, but not the primary method!") {
                    While you can use media queries in custom CSS, the theme file itself supports light/dark values directly.
                }
            }
        }
    }
}
