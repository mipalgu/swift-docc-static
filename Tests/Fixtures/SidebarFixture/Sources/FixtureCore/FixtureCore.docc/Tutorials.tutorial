@Tutorials(name: "Fixture Tutorials") {
    @Intro(title: "Drawing with FixtureCore") {
        Learn to draw points on a canvas.

        @Image(source: "canvas-diagram.png", alt: "A canvas with two points.")
    }

    @Chapter(name: "Basics") {
        Draw your first point, then connect points into shapes.

        @Image(source: "canvas-diagram.png", alt: "A canvas with two points.")

        @TutorialReference(tutorial: "doc:DrawingPoints")
    }

    @Chapter(name: "Shapes") {
        Connect points into shapes.

        @Image(source: "canvas-diagram.png", alt: "A canvas with two points.")

        @TutorialReference(tutorial: "doc:ConnectingPoints")
    }
}
