@Tutorial(time: 5) {
    @Intro(title: "Drawing Points") {
        Create a canvas and add a point to it.
    }

    @Section(title: "Create a Canvas") {
        @ContentAndMedia {
            Start with an empty canvas.
        }

        @Steps {
            @Step {
                Create the canvas.

                @Code(name: "main.swift", file: "drawing-01.swift")
            }

            @Step {
                Add a second point and find the midpoint.

                @Code(name: "main.swift", file: "drawing-02.swift")
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            Which type stores the points you draw?

            @Choice(isCorrect: true) {
                `Canvas`

                @Justification(reaction: "That's right!") {
                    A canvas collects the points added to it.
                }
            }

            @Choice(isCorrect: false) {
                `Point`

                @Justification(reaction: "Try again!") {
                    A point is a single position in the plane.
                }
            }
        }
    }
}
