{
  "theme": {
    "aside": {
      "border-radius": "8px",
      "border-width-inline": "3px 0"
    },
    "badge": {
      "border-radius": "3px"
    },
    "color": {
      "fill": { "light": "#ffffff", "dark": "#1d1d1f" },
      "fill-secondary": { "light": "#f5f5f7", "dark": "#2c2c2e" },
      "fill-tertiary": { "light": "#f5f5f7", "dark": "#3a3a3c" },
      "figure-gray": { "light": "#1d1d1f", "dark": "#f5f5f7" },
      "figure-gray-secondary": { "light": "#6e6e73", "dark": "#a1a1a6" },
      "figure-gray-tertiary": { "light": "#86868b", "dark": "#86868b" },
      "link": "#0066cc",
      "heading-link": "var(--color-link)",
      "fill-gray": { "light": "#d2d2d7", "dark": "#424245" },
      "fill-gray-secondary": { "light": "#e5e5ea", "dark": "#3a3a3c" },
      "fill-gray-tertiary": { "light": "#f2f2f7", "dark": "#2c2c2e" },
      "syntax-keywords": { "light": "#ad3da4", "dark": "#ff7ab2" },
      "syntax-other-type-names": { "light": "#703daa", "dark": "#dabaff" },
      "syntax-strings": { "light": "#d12f1b", "dark": "#ff8170" },
      "syntax-comments": { "light": "#707f8c", "dark": "#7f8c8d" },
      "syntax-numbers": { "light": "#272ad8", "dark": "#d9c97c" },
      "syntax-other-function-and-method-names": { "light": "#4b21b0", "dark": "#a167e6" },
      "documentation-intro-fill": { "light": "#f5f5f7", "dark": "#2c2c2e" },
      "hero-decoration": { "light": "#d2d2d7", "dark": "#4a4a4a" },
      "pre-background": { "light": "#f5f5f7", "dark": "#2c2c2e" },
      "kind-badge-fill": { "light": "#f5f5f7", "dark": "#2c2c2e" },
      "kind-badge-text": { "light": "#6e6e73", "dark": "#a1a1a6" },
      "kind-badge-border": { "light": "#d2d2d7", "dark": "#424245" },
      "aside-note-background": { "light": "#e3f2fd", "dark": "rgba(59, 130, 246, 0.15)" },
      "aside-note-border": { "light": "#2196f3", "dark": "#3b82f6" },
      "aside-warning-background": { "light": "#fff3e0", "dark": "rgba(245, 158, 11, 0.15)" },
      "aside-warning-border": { "light": "#ff9800", "dark": "#f59e0b" },
      "aside-important-background": { "light": "#fce4ec", "dark": "rgba(239, 68, 68, 0.15)" },
      "aside-tip-background": "transparent",
      "aside-experiment-background": "transparent",
      "inline-code-background": { "light": "#f5f5f7", "dark": "#2c2c2e" },
      "aside-important-border": { "light": "#e91e63", "dark": "#ef4444" },

      "technology-title-background": "transparent",
      "technology-title-background-hover": "transparent",
      "navigator-item-selected": "rgba(0, 102, 204, 0.1)",
      "tutorial-hero-background": "#1d1d1f",
      "tutorial-background": "var(--color-fill)",
      "tutorials-overview-fill": "var(--color-fill)",
      "navigator-filter-text": { "light": "#000000", "dark": "#f5f5f7" }
    },
    "typography": {
      "html-font": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif",
      "html-font-mono": "'SF Mono', SFMono-Regular, ui-monospace, Menlo, monospace",
      "html-font-headline": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', sans-serif"
    },
    "spacing": {
      "html-font-size": "16px",
      "body-font-size": "16px",
      "body-line-height": "1.5",
      "body-font-weight": "400",

      "h1-font-size": "2.125rem",
      "h1-line-height": "1.5",
      "h1-font-weight": "600",
      "h1-margin-bottom": "0.5rem",

      "h2-font-size": "1.5rem",
      "h2-line-height": "1.5",
      "h2-font-weight": "600",
      "h2-border-bottom": "1px solid var(--color-fill-gray)",
      "h2-padding-bottom": "0.5rem",
      "heading-margin-top": "1.5em",
      "heading-margin-bottom": "0.5em",

      "h3-font-size": "1.1875rem",
      "h3-line-height": "1.5",
      "h3-font-weight": "600",

      "h4-font-size": "1.0625rem",
      "h4-line-height": "1.5",
      "h4-font-weight": "600",

      "h5-font-size": "1rem",
      "h5-line-height": "1.5",
      "h5-font-weight": "600",

      "h6-font-size": "0.9375rem",
      "h6-line-height": "1.5",
      "h6-font-weight": "600",

      "eyebrow-font-size": "0.8125rem",
      "eyebrow-line-height": "1.5",
      "eyebrow-margin-bottom": "0.25rem",

      "abstract-font-size": "1.1875rem",
      "abstract-line-height": "1.5",
      "abstract-margin-bottom": "0",

      "declaration-padding": "1rem",
      "declaration-border-radius": "12px",
      "declaration-font-size": "0.875em",
      "declaration-line-height": "1.6",
      "declaration-source-line-height": "1.6",
      "declaration-source-margin": "1rem 0",

      "pre-font-size": "0.8125rem",
      "pre-line-height": "1.6",
      "pre-padding": "1rem",
      "pre-padding-left": "3rem",
      "pre-padding-right": "3rem",
      "pre-border": "none",
      "pre-border-radius": "12px",
      "pre-margin": "1rem 1.5rem",
      "pre-display": "block",
      "pre-code-position": "relative",
      "pre-code-left": "-1.5rem",
      "pre-code-padding": "0",
      "pre-code-font-size": "0.875em",
      "pre-code-line-height": "1.6",

      "content-padding-horizontal": "0",
      "content-block-padding-horizontal": "3rem",
      "paragraph-margin-bottom": "1rem",
      "section-padding-vertical": "1rem",
      "topic-abstract-margin-start": "0",
      "topic-abstract-font-size": "0.875rem",
      "topic-abstract-line-height": "1.4",
      "badge-font-size": "0.6875rem",
      "list-indent": "0",
      "list-padding": "1.5em",
      "list-item-margin-bottom": "0.5em",
      "aside-margin": "1rem 1.5rem",
      "aside-padding": "1rem 3rem",
      "aside-label-margin-bottom": "0.5rem",

      "code-font-size": "0.875em",
      "code-padding": "0.125em 0.25em",
      "code-border-radius": "4px",

      "table-margin": "1rem 1.5rem",
      "table-font-size": "0.9375rem",
      "table-line-height": "1.5",
      "table-cell-padding": "0.75rem 1rem",
      "table-header-font-weight": "600",

      "navigator-card-font-size": "0.8125rem",
      "navigator-card-line-height": "1.3",
      "navigator-card-min-height": "auto",
      "navigator-padding-vertical": "1rem",
      "navigator-group-font-size": "0.75rem",
      "sidebar-heading-title-font-size": "1rem",
      "sidebar-heading-font-size": "0.8125rem",

      "technology-title-display": "block",
      "technology-title-padding": "0",
      "technology-title-margin": "0",
      "technology-title-border-radius": "0",

      "card-link-font-size": "0.9375rem",
      "card-link-font-weight": "600",
      "card-link-line-height": "1.5",
      "card-link-padding": "0",
      "card-link-margin": "0",

      "leaf-link-font-size": "0.8125rem",
      "leaf-link-line-height": "1.3",
      "leaf-link-padding": "0",
      "leaf-link-margin": "0",

      "header-height": "52px",
      "header-padding-horizontal": "1.5rem",
      "header-toggle-border-radius": "6px",
      "header-language-font-size": "0.875rem",
      "small-font-size": "0.8125rem",
      "header-title-font-weight": "600",
      "header-title-font-size": "1rem",
      "header-title-line-height": "1.5",

      "hero-padding-top": "2rem",
      "hero-padding-bottom": "2.5rem",
      "hero-padding-left": "3rem",
      "hero-padding-right": "3rem",
      "hero-text-width-ratio": "0.7",
      "hero-max-width": "calc(var(--spacing-hero-text-width-ratio) * 100%)",
      "hero-margin-bottom": "2rem",
      "hero-margin-left": "0",
      "hero-margin-right": "0",

      "landing-max-width": "1200px",

      "sidebar-width": "320px"
    }
  },
  "features": {
    "docs": {
      "onThisPageNavigator": { "disable": true }
    }
  }
}
